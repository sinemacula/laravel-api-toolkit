{
    "name": "sinemacula/laravel-api-toolkit",
    "type": "library",
    "description": "Query parsing, schema-driven resources, repositories, services and OpenAPI export for Laravel APIs",
    "keywords": [
        "sine macula",
        "laravel",
        "restful",
        "api",
        "toolkit"
    ],
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Ben Carey",
            "email": "bdmc@sinemacula.co.uk"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "laravel/framework": "^13.39",
        "opis/json-schema": "^2.4",
        "sinemacula/http-primitives-php": "^2.0",
        "sinemacula/laravel-repositories": "^3.2.3"
    },
    "conflict": {
        "laravel/octane": "<2.0",
        "sinemacula/laravel-resource-exporter": "<3.1.2 || >=4.0"
    },
    "suggest": {
        "laravel/octane": "Flushes toolkit caches between requests when serving under Laravel Octane",
        "sinemacula/laravel-log-cloudwatch": "CloudWatch log driver (Monolog), extracted from this package",
        "sinemacula/laravel-log-database": "Database log driver (Monolog), extracted from this package",
        "sinemacula/laravel-resource-exporter": "Content-negotiated exports (CSV/TSV/XLSX/XML/JSON/NDJSON) for resources and collections; wires into resource responses automatically when installed",
        "sinemacula/laravel-sse": "Server-sent event streaming for controllers, extracted from this package"
    },
    "require-dev": {
        "brianium/paratest": "^7.20",
        "friendsofphp/php-cs-fixer": "^3.95.19",
        "infection/infection": "^0.33.2",
        "laravel/octane": "^2.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.0",
        "phpbench/phpbench": "^1.7",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpdoc-parser": "^2.3",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-mockery": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.5",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "sinemacula/coding-standards-laravel": "^1.7.1",
        "sinemacula/laravel-resource-exporter": "^3.1.2",
        "slevomat/coding-standard": "^8.28",
        "squizlabs/php_codesniffer": "^3.13.6 || ^4.0.2"
    },
    "autoload": {
        "psr-4": {
            "SineMacula\\ApiToolkit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Benchmarks\\": "benchmarks/",
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "bench": [
            "@php vendor/bin/phpbench run --config=phpbench.json --progress=plain --report=aggregate"
        ],
        "bench:ci": [
            "@php vendor/bin/phpbench run --config=phpbench.json --progress=plain --report=aggregate --dump-file=build/phpbench.xml"
        ],
        "bench:smoke": [
            "@php vendor/bin/phpbench run --config=phpbench.json --progress=plain --iterations=1 --revs=1"
        ],
        "check": [
            "qlty check"
        ],
        "format": [
            "qlty fmt"
        ],
        "smells": [
            "qlty smells"
        ],
        "test": [
            "@php vendor/bin/paratest"
        ],
        "test:coverage": [
            "@php vendor/bin/paratest --coverage-clover=clover.xml"
        ],
        "test:mutation": [
            "@php -d memory_limit=-1 vendor/bin/infection --configuration=infection.json5 --only-covering-test-cases --threads=max --git-diff-lines --git-diff-base=origin/master --map-source-class-to-test --min-msi=90 --min-covered-msi=90 --ignore-msi-with-no-mutations"
        ],
        "test:mutation:full": [
            "@php -d memory_limit=-1 vendor/bin/infection --configuration=infection.full.json5 --only-covering-test-cases --threads=max --min-msi=95 --min-covered-msi=95"
        ]
    },
    "scripts-descriptions": {
        "bench": "Run the benchmark suite and report each subject.",
        "bench:ci": "Run the benchmark suite and dump the results for CI.",
        "bench:smoke": "Run every benchmark subject once to prove it still runs.",
        "check": "Run static analysis and lint checks via qlty.",
        "format": "Format codebase using qlty.",
        "smells": "Report code smells (duplication, complexity) via qlty.",
        "test": "Run the PHPUnit test suite in parallel using Paratest.",
        "test:coverage": "Run the PHPUnit test suite with clover coverage report.",
        "test:mutation": "Run the Infection mutation-testing gate against the MSI thresholds.",
        "test:mutation:full": "Run the full Infection mutation suite against its MSI floor."
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SineMacula\\ApiToolkit\\ApiServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
