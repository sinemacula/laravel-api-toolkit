parameters:
    scanDirectories:
        - %currentWorkingDirectory%/src
        - %currentWorkingDirectory%/tests

    paths:
        - src
        - tests

    checkUninitializedProperties: false

    # Analyse the supported PHP range, not the PHP running the analyser
    phpVersion:
        min: 80300
        max: 80599

    # The rule only recognises the application config directory, not a package's
    ignoreErrors:
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            paths:
                - '*/config/*'
