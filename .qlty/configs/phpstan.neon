parameters:
    level: 8

    scanDirectories:
        - %currentWorkingDirectory%/src
        - %currentWorkingDirectory%/tests

    paths:
        - src
        - tests

    checkUninitializedProperties: false

    # The env-outside-config rule resolves the application config directory; a
    # package's own config directory is not that, so its env() reads are
    # reported as though they were application code.
    ignoreErrors:
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            paths:
                - '*/config/*'
